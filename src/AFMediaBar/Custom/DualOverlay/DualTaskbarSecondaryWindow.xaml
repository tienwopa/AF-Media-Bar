<Window x:Class="AFMediaBar.Custom.DualOverlay.DualTaskbarSecondaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:effects="clr-namespace:AFMediaBar.Custom.Effects"
        mc:Ignorable="d"
        Title="DualTaskbarSecondaryWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Visibility="Collapsed">

    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <!-- Canvas hiệu ứng nền hạt nhẹ nhàng phía sau lời bài hát -->
        <effects:LyricsBackgroundEffectCanvas x:Name="BackgroundEffectCanvas"
                                              TargetScope="DualTaskbarOnly"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              IsHitTestVisible="False" />

        <StackPanel x:Name="ContentStack" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="EntranceTranslate" X="0" Y="0" />
                    <ScaleTransform x:Name="EntranceScale" ScaleX="1.0" ScaleY="1.0" />
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Dòng 1 trên Màn hình 2 -->
            <TextBlock x:Name="PrimaryLineText"
                       Text=""
                       FontSize="12"
                       Foreground="#F2FFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="720">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="PrimaryShadow" Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Dòng 2 trên Màn hình 2 -->
            <TextBlock x:Name="SecondaryLineText"
                       Text=""
                       FontSize="11"
                       Foreground="#FFD54F"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="720"
                       Margin="0,1,0,0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="SecondaryShadow" Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
