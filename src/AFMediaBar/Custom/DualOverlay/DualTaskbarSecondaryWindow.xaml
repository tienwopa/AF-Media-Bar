<Window x:Class="AFMediaBar.Custom.DualOverlay.DualTaskbarSecondaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DualTaskbarSecondaryWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Visibility="Collapsed">

    <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <!-- Dòng 1 trên Màn hình 2 -->
            <TextBlock x:Name="PrimaryLineText"
                       Text=""
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Foreground="#F2FFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="500">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.6" />
                </TextBlock.Effect>
            </TextBlock>

            <!-- Dòng 2 trên Màn hình 2 (Nếu gộp cả 2 dòng ở màn hình 2) -->
            <TextBlock x:Name="SecondaryLineText"
                       Text=""
                       FontSize="10"
                       Foreground="#FFD54F"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="500"
                       Margin="0,1,0,0"
                       Visibility="Collapsed">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
