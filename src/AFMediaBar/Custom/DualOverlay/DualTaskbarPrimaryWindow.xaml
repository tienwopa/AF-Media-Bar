<Window x:Class="AFMediaBar.Custom.DualOverlay.DualTaskbarPrimaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:effects="clr-namespace:AFMediaBar.Custom.Effects"
        mc:Ignorable="d"
        Title="DualTaskbarPrimaryWindow"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Visibility="Collapsed">

    <Grid x:Name="RootLayout" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch">
        <!-- Canvas hiệu ứng nền hạt nhẹ nhàng phía sau lời bài hát -->
        <effects:LyricsBackgroundEffectCanvas x:Name="BackgroundEffectCanvas"
                                              TargetScope="DualTaskbarOnly"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              IsHitTestVisible="False" />

        <StackPanel x:Name="LinesStack" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="EntranceTranslate" X="0" Y="0" />
                    <ScaleTransform x:Name="EntranceScale" ScaleX="1.0" ScaleY="1.0" />
                </TransformGroup>
            </StackPanel.RenderTransform>

            <!-- Dòng 1: Lời dịch hoặc Pinyin tùy theo thiết lập thứ tự -->
            <ScrollViewer x:Name="PrimaryLineViewport" Width="480" ClipToBounds="True"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
              <TextBlock x:Name="PrimaryLineText"
                       Text=""
                       FontSize="11.5"
                       Foreground="#F2FFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="480">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="PrimaryShadow" Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
            </ScrollViewer>

            <!-- Dòng 2: Pinyin hoặc Lời dịch tùy theo thiết lập thứ tự -->
            <ScrollViewer x:Name="SecondaryLineViewport" Width="480" ClipToBounds="True"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="0,1,0,0" Visibility="Collapsed">
              <TextBlock x:Name="SecondaryLineText"
                       Text=""
                       FontSize="11"
                       Foreground="#FFD54F"
                       FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="480"
                       Margin="0,0,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="SecondaryShadow" Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
