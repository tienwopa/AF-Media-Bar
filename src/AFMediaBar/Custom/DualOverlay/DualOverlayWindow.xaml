<Window x:Class="AFMediaBar.Custom.DualOverlay.DualOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AFMediaBar.Custom.DualOverlay"
        mc:Ignorable="d"
        Title="Dual Overlay Lyrics"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="180"
        MinHeight="36"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
          Opacity="{Binding Opacity}"
          Margin="10">
        <!-- Nen vien bo tron kieu Fluent Design -->
        <Border CornerRadius="8"
                Background="#D918181B"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="12,6">
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="12"
                                  ShadowDepth="2"
                                  Opacity="0.4" />
            </Border.Effect>

            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                
                <!-- Dong loi goc (neu bat che do hien ca hai) -->
                <TextBlock Text="{Binding OriginalLyric}"
                           FontSize="{Binding FontSize}"
                           Foreground="#99FFFFFF"
                           FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OnlyShowsTranslation}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Dong loi dich (chinh cua Dual Overlay) -->
                <TextBlock Text="{Binding TranslatedLyric}"
                           FontSize="{Binding FontSize}"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"
                           FontFamily="Segoe UI, Microsoft YaHei, Aptos"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
