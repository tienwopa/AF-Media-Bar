<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:AFMediaBar.Components"
    xmlns:lyrics="clr-namespace:AFMediaBar.Classes.Services.Lyrics"
    xmlns:settings="clr-namespace:AFMediaBar.Classes.Settings"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="AFMediaBar.Views.Pages.LyricsPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="SourceOrderListStyle" TargetType="ItemsControl" BasedOn="{StaticResource AfSettingsSortableListStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.IsManualSourceRule}" Value="False">
                    <Setter Property="Template" Value="{StaticResource AfSettingsListTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="AfBareTextBoxTemplate" TargetType="{x:Type TextBox}">
            <ScrollViewer
                x:Name="PART_ContentHost"
                Focusable="False"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
        <Style x:Key="TwoLineRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureTwoLine}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.TwoLine.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="UnsungOpacityRowStyle"
            BasedOn="{StaticResource {x:Type components:SettingsRow}}"
            TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureUnsungOpacity}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LineGapRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureLineGap}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.LineGap.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LongLineScrollRowStyle" BasedOn="{StaticResource {x:Type components:SettingsRow}}" TargetType="{x:Type components:SettingsRow}">
            <Setter Property="Badge" Value="" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewModel.CanConfigureLongLineScroll}" Value="False">
                    <Setter Property="Badge" Value="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Badge}" />
                    <Setter Property="BadgeTone" Value="Attention" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:SettingsGroupStrip
            Margin="{StaticResource AfSettingsHeaderMargin}"
            MaxWidth="{StaticResource AfSettingsContentMaxWidth}"
            Grid.Row="0"
            PageIcon="{ui:SymbolIcon TextQuote24}"
            Subtitle="{DynamicResource Loc.Lyrics.Header.Subtitle}"
            Target="{Binding ElementName=PageScroll}"
            Title="{DynamicResource Loc.Common.Page.Lyrics}" />
        <ScrollViewer
            x:Name="PageScroll"
            Grid.Row="1"
            Margin="{StaticResource AfSettingsScrollMargin}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageRoot" MaxWidth="{StaticResource AfSettingsContentMaxWidth}" Loaded="OnPageLoaded">
                <components:SettingsGroup
                    GroupId="Common.Group.LyricsDisplay"
                    Header="{DynamicResource Loc.Common.Group.LyricsDisplay}"
                    Icon="{ui:SymbolIcon TextQuote24}">
                    <StackPanel>
                        <components:SettingsCallout
                            Margin="0,0,0,12"
                            IsAccent="True"
                            Symbol="TextQuote24"
                            Text="{DynamicResource Loc.Lyrics.Callout.Display}" />
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Description}"
                            Icon="{ui:SymbolIcon TextQuote24}"
                            Title="{DynamicResource Loc.Lyrics.Row.ShowLyrics.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.LyricsEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.TwoLine.Description}"
                            Icon="{ui:SymbolIcon TextAlignJustify24}"
                            Style="{StaticResource TwoLineRowStyle}"
                            Title="{DynamicResource Loc.Lyrics.Row.TwoLine.Title}">
                            <ui:ToggleSwitch
                                IsChecked="{Binding ViewModel.TwoLineLyricsEnabled, Mode=TwoWay}"
                                IsEnabled="{Binding ViewModel.CanConfigureTwoLine}" />
                        </components:SettingsRow>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon TextBulletListSquare24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Row.SecondLine.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsDiagram Margin="0,0,0,12" Kind="LyricsTwoLine" />
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.Row.SecondLine.Note}"
                                    Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.Row.SecondLine.Title}">
                                    <TextBlock
                                        MaxWidth="260"
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{Binding ViewModel.SecondaryLineOrderText}"
                                        TextWrapping="Wrap" />
                                </components:SettingsRow>
                                <AdornerDecorator>
                                    <ItemsControl Style="{StaticResource AfSettingsSortableListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.ReorderSecondaryLineCommand}" ItemsSource="{Binding ViewModel.SecondaryLineEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <components:SettingsRow Style="{StaticResource AfSettingsListItemStyle}" KeepControlInline="True"
                                                    Description="{DynamicResource Loc.Lyrics.Row.SecondLine.OrderRow.Description}"
                                                    IsNested="True"
                                                    Title="{Binding DisplayName}">
                                                    <components:SettingsReorderHandle ItemKey="{Binding Mode}" />
                                                </components:SettingsRow>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </AdornerDecorator>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.SecondLine.Reset.Description}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.SecondLine.Reset.Title}">
                                    <ui:Button
                                        Command="{Binding ViewModel.ResetSecondaryLineOrderCommand}"
                                        Content="{DynamicResource Loc.Lyrics.SecondLine.Reset.Title}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                            <components:SettingsNavigationButton ToolTip="{DynamicResource Loc.ContentLayout.Text.Shortcut.Description}"
                                Destination="Components" GroupId="Appearance.Group.RestLayout"
                                Content="{DynamicResource Loc.ContentLayout.Text.Shortcut.Action}" />
                        </WrapPanel>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Lyrics.Group.Presentation"
                    Header="{DynamicResource Loc.Lyrics.Group.Presentation}"
                    Icon="{ui:SymbolIcon TextColor24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Description}"
                            Icon="{ui:SymbolIcon TextColor24}"
                            Title="{DynamicResource Loc.Lyrics.Row.SyllableHighlight.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.SyllableHighlightEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.InfoLines.Description}"
                            Icon="{ui:SymbolIcon TextGrammarWand24}"
                            Title="{DynamicResource Loc.Lyrics.Row.InfoLines.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.InfoLineFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.FuriganaFilter.Description}"
                            Icon="{ui:SymbolIcon TextGrammarWand24}"
                            Title="{DynamicResource Loc.Lyrics.Row.FuriganaFilter.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.FuriganaFilterEnabled, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.BracketSymbols.Description}"
                            Icon="{ui:SymbolIcon TextQuote24}"
                            Title="{DynamicResource Loc.Lyrics.Row.BracketSymbols.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.BracketSymbolsHidden, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            IsExpanded="False"
                            Icon="{ui:SymbolIcon Translate24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow IsNested="True"
                                    Description="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Direction.Description}"
                                    Icon="{ui:SymbolIcon ArrowSwap24}"
                                    Title="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Direction.Title}">
                                    <ComboBox
                                        MinWidth="{StaticResource AfSettingsSelectShortWidth}"
                                        SelectedValue="{Binding ViewModel.ChineseConversion, Mode=TwoWay}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.Off}"
                                                      Tag="{x:Static settings:LyricsChineseConversionMode.None}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.ToTraditional}"
                                                      Tag="{x:Static settings:LyricsChineseConversionMode.SimplifiedToTraditional}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Row.ChineseConversion.Option.ToSimplified}"
                                                      Tag="{x:Static settings:LyricsChineseConversionMode.TraditionalToSimplified}" />
                                    </ComboBox>
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>
                        <ui:CardExpander
                            Style="{StaticResource AfSettingsExpanderStyle}"
                            IsExpanded="False"
                            Icon="{ui:SymbolIcon TextParagraph24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Settings.Advanced.Lyrics.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Settings.Advanced.Lyrics.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow IsNested="True"
                                    Description="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Description}"
                                    Icon="{ui:SymbolIcon CircleHalfFill24}"
                                    Style="{StaticResource UnsungOpacityRowStyle}"
                                    Title="{DynamicResource Loc.Lyrics.Row.UnsungOpacity.Title}">
                                    <components:SettingsNumericEditor
                                        Value="{Binding ViewModel.UnsungOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MinimumPercent}}"
                                        Maximum="{Binding Source={x:Static settings:LyricsUnsungOpacity.MaximumPercent}}"
                                        Step="{Binding Source={x:Static settings:LyricsUnsungOpacity.StepPercent}}"
                                        IsEnabled="{Binding ViewModel.CanConfigureUnsungOpacity}"
                                        Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                                </components:SettingsRow>
                                <components:SettingsRow IsNested="True"
                                    Description="{DynamicResource Loc.Lyrics.Row.LineGap.Description}"
                                    Icon="{ui:SymbolIcon TextAlignJustify24}"
                                    Style="{StaticResource LineGapRowStyle}"
                                    Title="{DynamicResource Loc.Lyrics.Row.LineGap.Title}">
                                    <components:SettingsNumericEditor
                                        Value="{Binding ViewModel.LineGapPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding Source={x:Static settings:LyricsLineGap.MinimumPercent}}"
                                        Maximum="{Binding Source={x:Static settings:LyricsLineGap.MaximumPercent}}"
                                        Step="{Binding Source={x:Static settings:LyricsLineGap.StepPercent}}"
                                        IsEnabled="{Binding ViewModel.CanConfigureLineGap}"
                                        Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                                </components:SettingsRow>
                                <components:SettingsRow IsNested="True"
                                    Description="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Description}"
                                    Icon="{ui:SymbolIcon TextFont24}"
                                    Title="{DynamicResource Loc.Lyrics.Row.CharacterSpacing.Title}">
                                    <components:SettingsNumericEditor
                                        Value="{Binding ViewModel.CharacterSpacingPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MinimumPercent}}"
                                        Maximum="{Binding Source={x:Static settings:LyricsCharacterSpacing.MaximumPercent}}"
                                        Step="{Binding Source={x:Static settings:LyricsCharacterSpacing.StepPercent}}"
                                        Unit="{DynamicResource Loc.Settings.Numeric.Percent}" />
                                </components:SettingsRow>
                                <components:SettingsRow IsNested="True"
                                    Description="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Description}"
                                    Icon="{ui:SymbolIcon ArrowAutofitWidth24}"
                                    Style="{StaticResource LongLineScrollRowStyle}"
                                    Title="{DynamicResource Loc.Lyrics.Row.LongLineScroll.Title}">
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.LongLineScrollEnabled, Mode=TwoWay}" IsEnabled="{Binding ViewModel.CanConfigureLongLineScroll}" />
                                </components:SettingsRow>
                            </StackPanel>
                        </ui:CardExpander>

                        <WrapPanel Style="{StaticResource AfSettingsRelatedLinksStyle}">
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.TextLayout}" Destination="Components" GroupId="Appearance.Group.RestLayout"/>
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.TextAppearance}" Destination="Appearance" GroupId="Common.Group.MediaBarText"/>
                            <components:SettingsNavigationButton Content="{DynamicResource Loc.Settings.Related.MediaBarLength}" Destination="Components" GroupId="Common.Group.MediaBarWidth"/>
                        </WrapPanel>
                    </StackPanel>
                </components:SettingsGroup>
                <components:SettingsGroup
                    GroupId="Common.Group.LyricsSources"
                    Header="{DynamicResource Loc.Common.Group.LyricsSources}"
                    Icon="{ui:SymbolIcon CloudArrowDown24}">
                    <StackPanel>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.BrowserVideo.Description}"
                            Icon="{ui:SymbolIcon Video24}"
                            Title="{DynamicResource Loc.Lyrics.Row.BrowserVideo.Title}">
                            <ui:ToggleSwitch IsChecked="{Binding ViewModel.AllowBrowserAndVideoLyrics, Mode=TwoWay}" />
                        </components:SettingsRow>
                        <components:SettingsRow
                            Description="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Description}"
                            Icon="{ui:SymbolIcon TextFont24}"
                            Title="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Title}">
                            <ui:Button
                                Click="ManageArtistSeparators_Click"
                                Icon="{ui:SymbolIcon Edit24}"
                                Content="{DynamicResource Loc.Lyrics.Row.ArtistSeparators.Manage}"
                                Style="{StaticResource AfSettingsButtonStyle}" />
                        </components:SettingsRow>
                        <ui:CardExpander Style="{StaticResource AfSettingsExpanderStyle}" Icon="{ui:SymbolIcon CloudArrowDown24}">
                            <ui:CardExpander.Header>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowTitleStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Sources.Expander.Title}" />
                                    <TextBlock
                                        Style="{StaticResource AfSettingsRowDescriptionStyle}"
                                        Text="{DynamicResource Loc.Lyrics.Sources.Expander.Description}" />
                                </StackPanel>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <components:SettingsRow
                                    Title="{DynamicResource Loc.Lyrics.Sources.Rule.Title}"
                                    Description="{Binding ViewModel.SourceRuleDescription}"
                                    IsNested="True">
                                    <ComboBox SelectedValue="{Binding ViewModel.SourceRule, Mode=TwoWay}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Rule.Default}" Tag="{x:Static settings:LyricsSourceRule.Default}" />
                                        <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Rule.Manual}" Tag="{x:Static settings:LyricsSourceRule.Manual}" />
                                    </ComboBox>
                                </components:SettingsRow>
                                <StackPanel Visibility="{Binding ViewModel.IsManualSourceRule, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                    <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Attempt.Title}"
                                        Description="{DynamicResource Loc.Lyrics.Sources.Attempt.Description}" IsNested="True">
                                        <ComboBox SelectedValue="{Binding ViewModel.SourceAttemptMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Attempt.Sequential}" Tag="{x:Static settings:LyricsSourceAttemptMode.Sequential}" />
                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Attempt.Parallel}" Tag="{x:Static settings:LyricsSourceAttemptMode.Parallel}" />
                                        </ComboBox>
                                    </components:SettingsRow>
                                    <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Result.Title}"
                                        Description="{Binding ViewModel.SourceResultDescription}" IsNested="True">
                                        <ComboBox SelectedValue="{Binding ViewModel.SourceResultMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Result.FirstAvailable}" Tag="{x:Static settings:LyricsSourceResultMode.FirstAvailable}" />
                                            <ComboBoxItem Content="{DynamicResource Loc.Lyrics.Sources.Result.Ordered}" Tag="{x:Static settings:LyricsSourceResultMode.Ordered}" />
                                        </ComboBox>
                                    </components:SettingsRow>
                                    <components:SettingsRow Title="{DynamicResource Loc.Lyrics.Sources.Order.Title}"
                                        Description="{DynamicResource Loc.Lyrics.Sources.Order.Description}" IsNested="True">
                                        <ui:Button Command="{Binding ViewModel.ResetSourceOrderCommand}"
                                            Content="{DynamicResource Loc.Lyrics.Sources.Order.Reset}" Icon="{ui:SymbolIcon ArrowReset24}"
                                            Style="{StaticResource AfSettingsButtonStyle}" />
                                    </components:SettingsRow>
                                </StackPanel>
                                <components:SettingsRow
                                    Description="{DynamicResource Loc.Lyrics.Sources.Reset.Description}"
                                    Icon="{ui:SymbolIcon ArrowReset24}"
                                    IsNested="True"
                                    Title="{DynamicResource Loc.Lyrics.Sources.Reset.Title}">
                                    <ui:Button
                                        Command="{Binding ViewModel.EnableAllSourcesCommand}"
                                        Content="{DynamicResource Loc.Lyrics.Sources.Reset.Action}"
                                        Icon="{ui:SymbolIcon ArrowReset24}"
                                        Style="{StaticResource AfSettingsButtonStyle}" />
                                </components:SettingsRow>
                                <AdornerDecorator>
                                    <ItemsControl Style="{StaticResource SourceOrderListStyle}" components:SettingsReorderBehavior.MoveCommand="{Binding ViewModel.ReorderSourceCommand}" ItemsSource="{Binding ViewModel.SourceEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <components:SettingsRow Style="{StaticResource AfSettingsListItemStyle}" KeepControlInline="True"
                                                    Description="{DynamicResource Loc.Lyrics.Sources.Row.Description}"
                                                    IsNested="True"
                                                    Title="{Binding DisplayName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding DataContext.ViewModel.IsManualSourceRule, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource AfBooleanToVisibilityConverter}}">
                                                            <components:SettingsReorderHandle ItemKey="{Binding SourceId}" />
                                                        </StackPanel>
                                                        <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </components:SettingsRow>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </AdornerDecorator>
                                <components:SettingsCallout Text="{DynamicResource Loc.Lyrics.Sources.AllDisabled.Callout}">
                                    <components:SettingsCallout.Style>
                                        <Style TargetType="{x:Type components:SettingsCallout}">
                                            <Setter Property="Margin" Value="0,8,0,0" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewModel.IsEverySourceDisabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </components:SettingsCallout.Style>
                                </components:SettingsCallout>
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </components:SettingsGroup>

                <!-- NHÓM CÀI ĐẶT: LỜI BÀI HÁT SONG NGỮ & DUAL TASKBAR -->
                <components:SettingsGroup
                    GroupId="Custom.Group.BilingualTaskbar"
                    Header="Lời bài hát Song ngữ &amp; Dual Taskbar"
                    Icon="{ui:SymbolIcon LocalLanguage24}">
                    <StackPanel>
                        <!-- 1. Bật lời bài hát song ngữ -->
                        <components:SettingsRow
                            Description="Tự động dịch lời bài hát sang Tiếng Việt bằng Google Translate và sinh Pinyin tiếng Trung"
                            Icon="{ui:SymbolIcon LocalLanguage24}"
                            Title="Bật lời bài hát Song ngữ">
                            <ui:ToggleSwitch x:Name="CustomEnableBilingualSwitch"
                                             Click="CustomEnableBilingualSwitch_Click" />
                        </components:SettingsRow>

                        <!-- 2. Bật thanh Dual Taskbar -->
                        <components:SettingsRow
                            Description="Nhúng thêm thanh hiển thị lời dịch / pinyin trực tiếp vào thanh Taskbar Windows"
                            Icon="{ui:SymbolIcon Desktop24}"
                            Title="Bật thanh Taskbar phụ (Dual Taskbar)">
                            <ui:ToggleSwitch x:Name="CustomEnableDualTaskbarSwitch"
                                             Click="CustomEnableDualTaskbarSwitch_Click" />
                        </components:SettingsRow>

                                                <!-- 3. Hiệu ứng chạy chữ Karaoke -->
                        <components:SettingsRow
                            Description="Hiệu ứng chạy màu chữ Karaoke theo giai điệu bài hát cho lời dịch và Pinyin"
                            Icon="{ui:SymbolIcon MusicNote224}"
                            Title="Chạy chữ Karaoke (Karaoke Highlight)">
                            <ui:ToggleSwitch x:Name="CustomEnableKaraokeSwitch"
                                             Click="CustomEnableKaraokeSwitch_Click" />
                        </components:SettingsRow>

                        <!-- 4. Tự động điều chỉnh màu theo nền Taskbar -->
                        <components:SettingsRow
                            Description="Tự động dùng màu tối khi thanh Taskbar sáng và màu sáng khi thanh Taskbar tối"
                            Icon="{ui:SymbolIcon DarkTheme24}"
                            Title="Tự động điều chỉnh màu theo nền Taskbar">
                            <ui:ToggleSwitch x:Name="CustomAutoAdaptColorSwitch"
                                             Click="CustomAutoAdaptColorSwitch_Click" />
                        </components:SettingsRow>

                        <!-- 4. Thứ tự dòng hiển thị song song -->
                        <components:SettingsRow
                            Description="Lựa chọn dòng nào ở trên, dòng nào ở dưới khi hiển thị song song 2 dòng"
                            Icon="{ui:SymbolIcon ArrowSort24}"
                            Title="Thứ tự dòng hiển thị">
                            <ComboBox x:Name="CustomLineOrderCombo"
                                      SelectionChanged="CustomLineOrderCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Lời dịch ở trên, Pinyin ở dưới (Mặc định)" Tag="0" />
                                <ComboBoxItem Content="Pinyin ở trên, Lời dịch ở dưới" Tag="1" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 5. Cỡ chữ Lời dịch Tiếng Việt -->
                        <components:SettingsRow
                            Description="Tùy chỉnh kích thước cỡ chữ cho bản dịch Tiếng Việt (chống lấn át Pinyin)"
                            Icon="{ui:SymbolIcon TextFontSize24}"
                            Title="Cỡ chữ Lời dịch Tiếng Việt">
                            <ComboBox x:Name="CustomTransFontSizeCombo"
                                      SelectionChanged="CustomTransFontSizeCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="9 pt (Rất nhỏ)" Tag="9.0" />
                                <ComboBoxItem Content="10 pt (Nhỏ)" Tag="10.0" />
                                <ComboBoxItem Content="10.5 pt" Tag="10.5" />
                                <ComboBoxItem Content="11 pt" Tag="11.0" />
                                <ComboBoxItem Content="11.5 pt (Tiêu chuẩn)" Tag="11.5" />
                                <ComboBoxItem Content="12 pt" Tag="12.0" />
                                <ComboBoxItem Content="13 pt (Lớn)" Tag="13.0" />
                                <ComboBoxItem Content="14 pt" Tag="14.0" />
                                <ComboBoxItem Content="15 pt" Tag="15.0" />
                                <ComboBoxItem Content="16 pt (Rất lớn)" Tag="16.0" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 6. Cỡ chữ Pinyin / Phiên âm -->
                        <components:SettingsRow
                            Description="Tùy chỉnh kích thước cỡ chữ cho Pinyin để rõ nét và tương xứng với lời Việt"
                            Icon="{ui:SymbolIcon TextFontSize24}"
                            Title="Cỡ chữ Pinyin / Phiên âm">
                            <ComboBox x:Name="CustomPinyinFontSizeCombo"
                                      SelectionChanged="CustomPinyinFontSizeCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="9 pt (Rất nhỏ)" Tag="9.0" />
                                <ComboBoxItem Content="10 pt (Nhỏ)" Tag="10.0" />
                                <ComboBoxItem Content="10.5 pt" Tag="10.5" />
                                <ComboBoxItem Content="11 pt (Tiêu chuẩn)" Tag="11.0" />
                                <ComboBoxItem Content="11.5 pt" Tag="11.5" />
                                <ComboBoxItem Content="12 pt" Tag="12.0" />
                                <ComboBoxItem Content="13 pt (Lớn)" Tag="13.0" />
                                <ComboBoxItem Content="14 pt" Tag="14.0" />
                                <ComboBoxItem Content="15 pt" Tag="15.0" />
                                <ComboBoxItem Content="16 pt (Rất lớn)" Tag="16.0" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 7. Độ đậm phông chữ (Nhấn mạnh) -->
                        <components:SettingsRow
                            Description="Lựa chọn dòng chữ được in đậm khi hiển thị song song 2 dòng"
                            Icon="{ui:SymbolIcon TextBold24}"
                            Title="Độ đậm phông chữ">
                            <ComboBox x:Name="CustomFontWeightCombo"
                                      SelectionChanged="CustomFontWeightCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Cân bằng (Độ đậm như nhau - Mặc định)" Tag="0" />
                                <ComboBoxItem Content="Ưu tiên Lời dịch (Lời dịch in đậm)" Tag="1" />
                                <ComboBoxItem Content="Ưu tiên Pinyin (Pinyin in đậm)" Tag="2" />
                                <ComboBoxItem Content="In đậm cả hai dòng" Tag="3" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 8. Phạm vi áp dụng chạy chữ Karaoke -->
                        <components:SettingsRow
                            Description="Chọn thành phần được áp dụng hiệu ứng chạy chữ Karaoke theo nhịp hát"
                            Icon="{ui:SymbolIcon MusicNote224}"
                            Title="Áp dụng chạy chữ Karaoke">
                            <ComboBox x:Name="CustomKaraokeTargetCombo"
                                      SelectionChanged="CustomKaraokeTargetCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Áp dụng cho cả Lời dịch và Pinyin" Tag="0" />
                                <ComboBoxItem Content="Chỉ áp dụng cho Pinyin (Chuẩn xác theo từng từ)" Tag="1" />
                                <ComboBoxItem Content="Chỉ áp dụng cho Lời dịch" Tag="2" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 5. Căn lề vị trí trên Màn hình thứ 2 -->
                        <components:SettingsRow
                            Description="Lựa chọn căn lề (Trái, Giữa, Phải) khi hiển thị trên Màn hình thứ 2"
                            Icon="{ui:SymbolIcon TextAlignJustify24}"
                            Title="Vị trí hiển thị tại Màn hình thứ 2">
                            <ComboBox x:Name="CustomSecondaryAlignCombo"
                                      SelectionChanged="CustomSecondaryAlignCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Căn giữa (Mặc định)" Tag="1" />
                                <ComboBoxItem Content="Căn trái" Tag="0" />
                                <ComboBoxItem Content="Căn phải" Tag="2" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 6. Vị trí hiển thị Lời dịch Tiếng Việt -->
                        <components:SettingsRow
                            Description="Chọn màn hình và vị trí hiển thị cho bản dịch Tiếng Việt"
                            Icon="{ui:SymbolIcon Translate24}"
                            Title="Vị trí hiển thị Lời dịch Tiếng Việt">
                            <ComboBox x:Name="CustomTransPlacementCombo"
                                      SelectionChanged="CustomTransPlacementCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Phía đối diện Taskbar chính" />
                                <ComboBoxItem Content="Màn hình thứ 2" />
                                <ComboBoxItem Content="Hiển thị trên cả hai màn hình" />
                                <ComboBoxItem Content="Không hiển thị (Tắt)" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 7. Vị trí hiển thị Pinyin / Phiên âm -->
                        <components:SettingsRow
                            Description="Chọn màn hình và vị trí hiển thị cho Pinyin (tự động tạo cho bài hát tiếng Trung)"
                            Icon="{ui:SymbolIcon DocumentText24}"
                            Title="Vị trí hiển thị Pinyin / Phiên âm">
                            <ComboBox x:Name="CustomPinyinPlacementCombo"
                                      SelectionChanged="CustomPinyinPlacementCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Phía đối diện Taskbar chính" />
                                <ComboBoxItem Content="Màn hình thứ 2" />
                                <ComboBoxItem Content="Hiển thị trên cả hai màn hình" />
                                <ComboBoxItem Content="Không hiển thị (Tắt)" />
                            </ComboBox>
                        </components:SettingsRow>

                                                <!-- 8. Thời gian hiển thị Lời dịch (Sớm/Trễ) -->
                        <components:SettingsRow
                            Description="Bù trừ thời gian hiển thị Lời dịch: Số dương (+) hiển thị sớm hơn, số âm (-) hiển thị trễ hơn"
                            Icon="{ui:SymbolIcon Timer24}"
                            Title="Thời gian hiển thị Lời dịch">
                            <components:SettingsNumericEditor
                                Value="{Binding TranslationOffsetMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="-3000"
                                Maximum="3000"
                                Step="50"
                                Unit="ms" />
                        </components:SettingsRow>

                        <!-- 9. Thời gian hiển thị Pinyin (Sớm/Trễ) -->
                        <components:SettingsRow
                            Description="Bù trừ thời gian hiển thị Pinyin: Số dương (+) hiển thị sớm hơn, số âm (-) hiển thị trễ hơn"
                            Icon="{ui:SymbolIcon Timer24}"
                            Title="Thời gian hiển thị Pinyin">
                            <components:SettingsNumericEditor
                                Value="{Binding RomanizationOffsetMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="-3000"
                                Maximum="3000"
                                Step="50"
                                Unit="ms" />
                        </components:SettingsRow>

                        <!-- 10. Màu sắc chữ Lời dịch -->
                        <components:SettingsRow
                            Description="Tùy chỉnh màu sắc chữ cho dòng lời dịch Tiếng Việt (khi tắt tự động theo nền)"
                            Icon="{ui:SymbolIcon Color24}"
                            Title="Màu sắc Lời dịch">
                            <ComboBox x:Name="CustomTransColorCombo"
                                      SelectionChanged="CustomTransColorCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Trắng sáng (#FFFFFF)" Tag="#FFFFFF" />
                                <ComboBoxItem Content="Đen huyền (#18181B)" Tag="#18181B" />
                                <ComboBoxItem Content="Đen tuyền (#000000)" Tag="#000000" />
                                <ComboBoxItem Content="Vàng kim (#FFD54F)" Tag="#FFD54F" />
                                <ComboBoxItem Content="Xanh ngọc (#4FC3F7)" Tag="#4FC3F7" />
                                <ComboBoxItem Content="Xanh Mint (#81C784)" Tag="#81C784" />
                                <ComboBoxItem Content="Hồng phấn (#F48FB1)" Tag="#F48FB1" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 11. Màu sắc chữ Pinyin -->
                        <components:SettingsRow
                            Description="Tùy chỉnh màu sắc chữ cho dòng Pinyin / Phiên âm (khi tắt tự động theo nền)"
                            Icon="{ui:SymbolIcon Color24}"
                            Title="Màu sắc Pinyin">
                            <ComboBox x:Name="CustomPinyinColorCombo"
                                      SelectionChanged="CustomPinyinColorCombo_SelectionChanged"
                                      Width="280">
                                <ComboBoxItem Content="Vàng kim (#FFD54F)" Tag="#FFD54F" />
                                <ComboBoxItem Content="Trắng sáng (#FFFFFF)" Tag="#FFFFFF" />
                                <ComboBoxItem Content="Đen huyền (#18181B)" Tag="#18181B" />
                                <ComboBoxItem Content="Đen tuyền (#000000)" Tag="#000000" />
                                <ComboBoxItem Content="Xanh ngọc (#4FC3F7)" Tag="#4FC3F7" />
                                <ComboBoxItem Content="Xanh Mint (#81C784)" Tag="#81C784" />
                                <ComboBoxItem Content="Cam ấm (#FFB74D)" Tag="#FFB74D" />
                            </ComboBox>
                        </components:SettingsRow>

                        <!-- 12. Tự động ẩn khi bài hát là Tiếng Việt -->
                        <components:SettingsRow
                            Description="Không hiển thị bản dịch khi bài hát gốc vốn đã là Tiếng Việt để tránh trùng lặp"
                            Icon="{ui:SymbolIcon CheckmarkCircle24}"
                            Title="Bỏ qua dịch khi lời gốc là Tiếng Việt">
                            <ui:ToggleSwitch x:Name="CustomAutoSkipVietnameseSwitch"
                                             Click="CustomAutoSkipVietnameseSwitch_Click" />
                        </components:SettingsRow>
                    </StackPanel>
                </components:SettingsGroup>
                <ui:Button
                    Margin="0,16,0,40"
                    HorizontalAlignment="Left"
                    Click="ResetButton_Click"
                    Content="{DynamicResource Loc.Common.ResetPageDefaults}"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Style="{StaticResource AfSettingsButtonStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
